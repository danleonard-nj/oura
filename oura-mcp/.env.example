# Copy to .env for local development. Never commit a filled-in copy.
# In Kubernetes these come from Secrets, not from a file.

# ── Oura OAuth application ────────────────────────────────────────────────
# From https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must match the redirect URI registered on the Oura application exactly.
OURA_REDIRECT_URI=http://localhost:8000/oauth/callback
# Space-separated. Omit to use the default full read-only set.
# stress, heart_health and ring_configuration are undocumented but required by
# daily_resilience, cardiovascular age / VO2 max, and ring info respectively.
OURA_SCOPES=email personal daily heartrate workout tag session spo2 stress heart_health ring_configuration
# Namespaces tokens, cache keys, locks and audit records. One account today.
OURA_ACCOUNT_ID=default

# ── MCP ───────────────────────────────────────────────────────────────────
# Bearer token required on /mcp. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_KEY=
MCP_PATH=/mcp
# Stateless transport: any replica can serve any request, no sticky sessions.
MCP_STATELESS=true
# Extra Host values the MCP transport accepts, comma-separated. Only needed when
# a reverse proxy rewrites Host before the request reaches this service, such as
# the api-gateway forwarding to the cluster-internal name.
MCP_EXTRA_ALLOWED_HOSTS=
# Set to enable MCP OAuth, which clients offering only OAuth or no auth require
# (ChatGPT). Unset, the OAuth routes are not mounted and only MCP_API_KEY works.
# Typed on the consent screen to approve an authorization, and compared
# directly -- so generate it, do not choose it:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_OWNER_PASSWORD=

# ── Secrets ───────────────────────────────────────────────────────────────
# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates stored tokens; the account must reconnect.
TOKEN_ENCRYPTION_KEY=

# ── Infrastructure ────────────────────────────────────────────────────────
# Against a port-forwarded replica set, add ?directConnection=true so the
# driver does not chase the internally-advertised replica hostnames.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=oura_mcp
REDIS_URL=redis://localhost:6379/0

# ── HTTP ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# The ingress hostname, no scheme. Required in production: the MCP transport's
# DNS-rebinding protection rejects any Host header not on the allowlist.
PUBLIC_HOST=
LOG_LEVEL=INFO

# ── Webhooks ──────────────────────────────────────────────────────────────
# Your own random string, supplied when creating the Oura subscription and
# echoed back during verification. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OURA_WEBHOOK_VERIFICATION_TOKEN=
WEBHOOK_DEDUPE_TTL_SECONDS=3600

# ── Tuning (all optional) ─────────────────────────────────────────────────
# Ceiling on concurrent blocking Oura calls; also a rate-limit guard.
OURA_EXECUTOR_WORKERS=8
OURA_REQUEST_TIMEOUT_SECONDS=30
OURA_MAX_ATTEMPTS=3
OURA_MAX_RANGE_DAYS=180
OURA_MAX_HEARTRATE_DAYS=14

CACHE_ENABLED=true
CACHE_TTL_RECENT_SECONDS=300
CACHE_TTL_HISTORICAL_SECONDS=21600
CACHE_TTL_STATIC_SECONDS=86400

REFRESH_LOCK_TTL_SECONDS=30
REFRESH_LOCK_WAIT_SECONDS=15
TOKEN_EXPIRY_SKEW_SECONDS=120
OAUTH_STATE_TTL_SECONDS=600
