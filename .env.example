# Shared local-dev env file for oura-mcp, oura-sync, and oura-auth.
# Copy to .env at this same level (the repo root) and fill it in. Never
# commit a filled-in copy.
#
# Why one file: oura-mcp and oura-sync run in the same Kubernetes namespace,
# read/write the same oauth_tokens collection, and need several identical
# values (Oura app credentials, TOKEN_ENCRYPTION_KEY, MONGODB_URI, REDIS_URL).
# Keeping two near-duplicate .env files in sync by hand was the actual
# problem; one file with both services' variables is not.
#
# Each service finds this automatically with zero configuration: python-dotenv's
# load_dotenv() (called with no path in each service's app.py) walks UP from
# the calling file's directory looking for a .env, not from the current
# working directory -- so as long as neither oura-mcp/ nor oura-sync/ has its
# own .env, this one is found regardless of which directory you run from.
# oura-auth is a plain CLI, not a long-running service, and reads whatever
# --env-file you pass it (default ./.env): run it as
#   cd oura-auth && python oura_auth.py connect --env-file ../.env

# ── Oura OAuth application (oura-mcp, oura-sync, oura-auth) ───────────────
# From https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must match the redirect URI registered on the Oura application exactly.
# oura-sync never uses this for a real redirect (it only refreshes tokens),
# but shared config validation still requires it to be set.
OURA_REDIRECT_URI=http://localhost:8000/oauth/callback
# Space-separated. Omit to use the default full read-only set.
# stress, heart_health and ring_configuration are undocumented but required by
# daily_resilience, cardiovascular age / VO2 max, and ring info respectively.
OURA_SCOPES=email personal daily heartrate workout tag session spo2 stress heart_health ring_configuration
# Namespaces tokens, cache keys, locks and audit records. One account today,
# and must be the same value across oura-mcp and oura-sync.
OURA_ACCOUNT_ID=default

# ── Secrets (oura-mcp, oura-sync, oura-auth) ───────────────────────────────
# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be byte-identical across all three -- they decrypt the same documents.
# Rotating this invalidates stored tokens; the account must reconnect.
TOKEN_ENCRYPTION_KEY=

# ── Infrastructure (oura-mcp, oura-sync) ───────────────────────────────────
# Against a port-forwarded replica set, add ?directConnection=true so the
# driver does not chase the internally-advertised replica hostnames.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=oura_mcp
REDIS_URL=redis://localhost:6379/0

# ── oura-mcp only ───────────────────────────────────────────────────────────
# Bearer token required on /mcp and /api/*. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_KEY=
MCP_PATH=/mcp
MCP_STATELESS=true
MCP_EXTRA_ALLOWED_HOSTS=
# Set to enable MCP OAuth (ChatGPT and other discovery-only clients).
MCP_OWNER_PASSWORD=
HOST=0.0.0.0
PORT=8000
PUBLIC_HOST=
# Your own random string, echoed back during Oura webhook verification.
OURA_WEBHOOK_VERIFICATION_TOKEN=
WEBHOOK_DEDUPE_TTL_SECONDS=3600

# ── oura-sync only ──────────────────────────────────────────────────────────
# Which resources to poll on POST /internal/sync/run when the caller does not
# override the list.
SYNC_RESOURCES=ring_configuration,ring_battery_level,personal_info

# ── oura-mcp calling oura-sync (the gateway-auth pattern both sides use) ───
# This deployment's own Azure AD app registration, used by oura-mcp as the
# *caller* identity when requesting a token scoped to oura-sync.
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=
# oura-sync's Application ID URI + "/.default", e.g.
# api://<oura-sync-app-id>/.default -- the SCOPE oura-mcp requests a token for.
AAD_SYNC_SCOPE=
SYNC_SERVICE_BASE_URL=

# ── oura-sync validating inbound calls (from oura-mcp and the cron scheduler) ─
# oura-sync's own Application ID URI -- the AUDIENCE it checks incoming tokens
# against. Same underlying app registration as AAD_SYNC_SCOPE above, without
# the "/.default" suffix: AAD_SYNC_SCOPE is what a caller requests,
# AAD_AUDIENCE is what the resource server (oura-sync) validates against.
AAD_AUDIENCE=
# Optional: also require this value in the token's `roles` claim.
AAD_REQUIRED_ROLE=

# ── Tuning (all optional, shared meaning across oura-mcp and oura-sync) ────
OURA_EXECUTOR_WORKERS=8
OURA_REQUEST_TIMEOUT_SECONDS=30
OURA_MAX_ATTEMPTS=3
OURA_MAX_RANGE_DAYS=180
OURA_MAX_HEARTRATE_DAYS=14

CACHE_ENABLED=true
CACHE_TTL_RECENT_SECONDS=300
CACHE_TTL_HISTORICAL_SECONDS=21600
CACHE_TTL_STATIC_SECONDS=86400

REFRESH_LOCK_TTL_SECONDS=30
REFRESH_LOCK_WAIT_SECONDS=15
TOKEN_EXPIRY_SKEW_SECONDS=120
OAUTH_STATE_TTL_SECONDS=600

LOG_LEVEL=INFO
