# oura-auth reads the same variables as oura-mcp, so the two can share a file.
# Copy to .env and fill in. Never commit a filled-in copy.

OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# For the local bootstrap, point this at a loopback address and register the
# SAME value on the Oura application. The script serves it itself.
OURA_REDIRECT_URI=http://localhost:8000/oauth/callback

OURA_SCOPES=email personal daily heartrate workout tag session spo2 stress heart_health ring_configuration
OURA_ACCOUNT_ID=default

# MUST be byte-identical to the key oura-mcp and oura-sync run with, or they
# cannot decrypt what this writes.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Against a port-forwarded replica set, add ?directConnection=true.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=oura_mcp
