# Env file for the oura-auth bootstrap tool. Copy to .env at this same level
# (the repo root) and fill it in. Never commit a filled-in copy. Run it as
#   cd oura-auth && python oura_auth.py connect --env-file ../.env
#
# oura-sync does NOT read this file any more: it is configured from
# config.json (template: oura-sync/config.example.json; see its README,
# "Configuration"). The entries below that only oura-sync used are kept as a
# reference to the old names -- the README maps each one to its config.json key.

# ── Oura OAuth application (oura-sync, oura-auth) ─────────────────────────
# From https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must match the redirect URI registered on the Oura application exactly.
OURA_REDIRECT_URI=http://localhost:8000/oauth/callback
# Space-separated. Omit to use the default full read-only set.
# stress, heart_health and ring_configuration are undocumented but required by
# daily_resilience, cardiovascular age / VO2 max, and ring info respectively.
OURA_SCOPES=email personal daily heartrate workout tag session spo2 stress heart_health ring_configuration
# Namespaces tokens, cache keys, locks and audit records. One account today,
# and must match what oura-auth connected.
OURA_ACCOUNT_ID=default

# ── Secrets (oura-sync, oura-auth) ─────────────────────────────────────────
# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be byte-identical in both -- they decrypt the same documents.
# Rotating this invalidates stored tokens; the account must reconnect.
TOKEN_ENCRYPTION_KEY=

# ── Infrastructure ──────────────────────────────────────────────────────────
# Against a port-forwarded replica set, add ?directConnection=true so the
# driver does not chase the internally-advertised replica hostnames.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DATABASE=oura_mcp
REDIS_URL=redis://localhost:6379/0

# ── MCP ─────────────────────────────────────────────────────────────────────
# Bearer token required on /mcp and /api/*. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_KEY=
MCP_PATH=/mcp
MCP_STATELESS=true
MCP_EXTRA_ALLOWED_HOSTS=
# Set to enable MCP OAuth (ChatGPT and other discovery-only clients).
MCP_OWNER_PASSWORD=
# Only needed with more than one replica: seals MCP request state so any
# replica can open it. At least 32 characters; comma-separate to rotate.
MCP_REQUEST_STATE_SECRET=
HOST=0.0.0.0
PORT=8000
PUBLIC_HOST=
# Your own random string, echoed back during Oura webhook verification.
OURA_WEBHOOK_VERIFICATION_TOKEN=
WEBHOOK_DEDUPE_TTL_SECONDS=3600

# ── Snapshot sync ───────────────────────────────────────────────────────────
# Which resources to poll on POST /internal/sync/run when the caller does not
# override the list.
SYNC_RESOURCES=ring_configuration,ring_battery_level,personal_info

# ── Gateway auth on /internal/sync/run and /api/snapshots/* ────────────────
# The cron scheduler calls these with an Azure AD client-credentials token.
# AAD_AUDIENCE is this service's own Application ID URI (no "/.default").
AAD_TENANT_ID=
AAD_AUDIENCE=
# Optional: also require this value in the token's `roles` claim.
AAD_REQUIRED_ROLE=

# ── Tuning (all optional) ───────────────────────────────────────────────────
OURA_EXECUTOR_WORKERS=8
OURA_REQUEST_TIMEOUT_SECONDS=30
OURA_MAX_ATTEMPTS=3
OURA_MAX_RANGE_DAYS=180
OURA_MAX_HEARTRATE_DAYS=14

CACHE_ENABLED=true
CACHE_TTL_RECENT_SECONDS=300
CACHE_TTL_HISTORICAL_SECONDS=21600
CACHE_TTL_STATIC_SECONDS=86400

REFRESH_LOCK_TTL_SECONDS=30
REFRESH_LOCK_WAIT_SECONDS=15
TOKEN_EXPIRY_SKEW_SECONDS=120
OAUTH_STATE_TTL_SECONDS=600

LOG_LEVEL=INFO
